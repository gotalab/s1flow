"""{task_id}: {doc}

Cases: tasks/{task_id}/data.jsonl, one labelled case per line, for example
    {{"id": "1", "text": "...", "label": true}}
`state` turns a row into what the model sees (the same shape your app will send at runtime);
`label` is the right answer (None leaves the row out).
"""

from s1flow.objectives import Accuracy
from s1flow.questions import Boolean
from s1flow.eval import Task

task = Task(
    id={task_id_repr},
    cases="data.jsonl",
    state=lambda r: {{"text": r["text"]}},
    question_id="q",
    question=Boolean(instructions={instructions}),
    label=lambda r: r["label"],
    # What to choose by (it also sets how the policy reads the answers; tiebreak=[...] breaks ties). Others: Recall(max_false_alarm=0.05), ExpectedLoss(fn=5, fp=1),
    # F1(), or Coverage(target_accuracy=0.95) when the workflow acts only on sure answers.
    objective=Accuracy(),
)
