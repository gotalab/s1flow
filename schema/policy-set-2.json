{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/gotalab/s1flow/blob/main/schema/policy-set-2.json",
 "$defs": {
  "Asked": {
   "additionalProperties": false,
   "properties": {
    "question": {
     "discriminator": {
      "mapping": {
       "boolean": "#/$defs/Boolean",
       "box": "#/$defs/Box",
       "choice": "#/$defs/Choice",
       "date": "#/$defs/Date",
       "estimate": "#/$defs/RangeEstimate",
       "multichoice": "#/$defs/MultiChoice",
       "number": "#/$defs/Number",
       "score": "#/$defs/Score",
       "text": "#/$defs/Text"
      },
      "propertyName": "type"
     },
     "oneOf": [
      {
       "$ref": "#/$defs/Boolean"
      },
      {
       "$ref": "#/$defs/Choice"
      },
      {
       "$ref": "#/$defs/Score"
      },
      {
       "$ref": "#/$defs/Box"
      },
      {
       "$ref": "#/$defs/Text"
      },
      {
       "$ref": "#/$defs/Number"
      },
      {
       "$ref": "#/$defs/Date"
      },
      {
       "$ref": "#/$defs/RangeEstimate"
      },
      {
       "$ref": "#/$defs/MultiChoice"
      }
     ],
     "title": "Question"
    },
    "kind": {
     "$ref": "#/$defs/KindParams",
     "default": {}
    },
    "rule": {
     "$ref": "#/$defs/DecisionRule"
    }
   },
   "required": [
    "question",
    "rule"
   ],
   "title": "Asked",
   "type": "object"
  },
  "Boolean": {
   "additionalProperties": false,
   "properties": {
    "type": {
     "const": "boolean",
     "default": "boolean",
     "title": "Type",
     "type": "string"
    },
    "instructions": {
     "title": "Instructions",
     "type": "string"
    },
    "criteria": {
     "anyOf": [
      {
       "additionalProperties": {
        "type": "string"
       },
       "type": "object"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Criteria"
    }
   },
   "required": [
    "instructions"
   ],
   "title": "Boolean",
   "type": "object"
  },
  "Box": {
   "additionalProperties": false,
   "description": "One bounding box of the target described in `instructions` (jev 1.14, 2026-10-15).\n\nA model that can say the target is not in the picture answers with no box (Liquid d1.2). The others always\ngive one (jev): ask them a Boolean alongside when the target may be absent.",
   "properties": {
    "type": {
     "const": "box",
     "default": "box",
     "title": "Type",
     "type": "string"
    },
    "instructions": {
     "title": "Instructions",
     "type": "string"
    }
   },
   "required": [
    "instructions"
   ],
   "title": "Box",
   "type": "object"
  },
  "Choice": {
   "additionalProperties": false,
   "properties": {
    "type": {
     "const": "choice",
     "default": "choice",
     "title": "Type",
     "type": "string"
    },
    "instructions": {
     "title": "Instructions",
     "type": "string"
    },
    "criteria": {
     "additionalProperties": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "title": "Criteria",
     "type": "object"
    }
   },
   "required": [
    "instructions",
    "criteria"
   ],
   "title": "Choice",
   "type": "object"
  },
  "Date": {
   "additionalProperties": false,
   "description": "A calendar date read from the state, None when the state holds none.",
   "properties": {
    "type": {
     "const": "date",
     "default": "date",
     "title": "Type",
     "type": "string"
    },
    "instructions": {
     "title": "Instructions",
     "type": "string"
    }
   },
   "required": [
    "instructions"
   ],
   "title": "Date",
   "type": "object"
  },
  "DecisionRule": {
   "additionalProperties": false,
   "description": "Binary threshold and optional lower bound on the chosen value's probability.",
   "properties": {
    "threshold": {
     "anyOf": [
      {
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Threshold"
    },
    "min_probability": {
     "anyOf": [
      {
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Min Probability"
    }
   },
   "title": "DecisionRule",
   "type": "object"
  },
  "Entry": {
   "additionalProperties": false,
   "properties": {
    "version": {
     "minimum": 1,
     "title": "Version",
     "type": "integer"
    },
    "digest": {
     "title": "Digest",
     "type": "string"
    },
    "policy": {
     "$ref": "#/$defs/PolicySpec"
    }
   },
   "required": [
    "version",
    "digest",
    "policy"
   ],
   "title": "Entry",
   "type": "object"
  },
  "KindParams": {
   "additionalProperties": false,
   "description": "What a question's type leaves open, the same in a task (`Task.kind_params`) and a policy (`kind`):\n`positive` scores a choice as binary (P(positive) against a true / false label), `iou` is a box's bar\nfor a hit (0.5 when unset), `tolerance` how far from the label an estimate is still right (half a step when\nunset; a hundredth of the range for a question without a step). An unset one is left out of the JSON.",
   "properties": {
    "positive": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Positive"
    },
    "iou": {
     "anyOf": [
      {
       "exclusiveMinimum": 0,
       "maximum": 1,
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Iou"
    },
    "tolerance": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Tolerance"
    }
   },
   "title": "KindParams",
   "type": "object"
  },
  "MultiChoice": {
   "additionalProperties": false,
   "description": "Every option that applies, possibly none: each option is its own yes or no (Liquid d1.2, 2026-11-17, where\nit is a `choice` with `multiple`).",
   "properties": {
    "type": {
     "const": "multichoice",
     "default": "multichoice",
     "title": "Type",
     "type": "string"
    },
    "instructions": {
     "title": "Instructions",
     "type": "string"
    },
    "criteria": {
     "additionalProperties": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "title": "Criteria",
     "type": "object"
    }
   },
   "required": [
    "instructions",
    "criteria"
   ],
   "title": "MultiChoice",
   "type": "object"
  },
  "Number": {
   "additionalProperties": false,
   "description": "A number read from the state, None when the state holds none. `unit` names what it is counted in (USD, kg).",
   "properties": {
    "type": {
     "const": "number",
     "default": "number",
     "title": "Type",
     "type": "string"
    },
    "instructions": {
     "title": "Instructions",
     "type": "string"
    },
    "unit": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Unit"
    }
   },
   "required": [
    "instructions"
   ],
   "title": "Number",
   "type": "object"
  },
  "PolicySpec": {
   "additionalProperties": false,
   "properties": {
    "schema": {
     "const": "s1flow/policy@2",
     "default": "s1flow/policy@2",
     "title": "Schema",
     "type": "string"
    },
    "task": {
     "title": "Task",
     "type": "string"
    },
    "version": {
     "minimum": 1,
     "title": "Version",
     "type": "integer"
    },
    "connection": {
     "title": "Connection",
     "type": "string"
    },
    "model_id": {
     "minLength": 1,
     "title": "Model Id",
     "type": "string"
    },
    "questions": {
     "additionalProperties": {
      "$ref": "#/$defs/Asked"
     },
     "maxProperties": 1,
     "minProperties": 1,
     "title": "Questions",
     "type": "object"
    },
    "at": {
     "title": "At",
     "type": "string"
    },
    "s1flow_version": {
     "title": "S1Flow Version",
     "type": "string"
    },
    "state_schema": {
     "anyOf": [
      {
       "additionalProperties": true,
       "type": "object"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "State Schema"
    }
   },
   "required": [
    "task",
    "version",
    "connection",
    "model_id",
    "questions"
   ],
   "title": "PolicySpec",
   "type": "object"
  },
  "RangeEstimate": {
   "additionalProperties": false,
   "description": "A number between `min` and `max` the state does not state: the model's estimate, with the p10 - p90 interval\nof its distribution. `step` is the spacing of the values it may take (1 for a count).",
   "properties": {
    "type": {
     "const": "estimate",
     "default": "estimate",
     "title": "Type",
     "type": "string"
    },
    "instructions": {
     "title": "Instructions",
     "type": "string"
    },
    "min": {
     "title": "Min",
     "type": "number"
    },
    "max": {
     "title": "Max",
     "type": "number"
    },
    "step": {
     "anyOf": [
      {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Step"
    },
    "unit": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Unit"
    }
   },
   "required": [
    "instructions",
    "min",
    "max"
   ],
   "title": "RangeEstimate",
   "type": "object"
  },
  "Score": {
   "additionalProperties": false,
   "description": "Levels 0..L-1, described in order by `criteria`.",
   "properties": {
    "type": {
     "const": "score",
     "default": "score",
     "title": "Type",
     "type": "string"
    },
    "instructions": {
     "title": "Instructions",
     "type": "string"
    },
    "criteria": {
     "items": {
      "type": "string"
     },
     "title": "Criteria",
     "type": "array"
    }
   },
   "required": [
    "instructions",
    "criteria"
   ],
   "title": "Score",
   "type": "object"
  },
  "Text": {
   "additionalProperties": false,
   "description": "A passage read from the state as it is written (an invoice number, a name). The answer's value is None\nwhen the state holds nothing for it.",
   "properties": {
    "type": {
     "const": "text",
     "default": "text",
     "title": "Type",
     "type": "string"
    },
    "instructions": {
     "title": "Instructions",
     "type": "string"
    }
   },
   "required": [
    "instructions"
   ],
   "title": "Text",
   "type": "object"
  }
 },
 "additionalProperties": false,
 "properties": {
  "schema": {
   "const": "s1flow/policy-set@2",
   "default": "s1flow/policy-set@2",
   "title": "Schema",
   "type": "string"
  },
  "channel": {
   "const": "current",
   "title": "Channel",
   "type": "string"
  },
  "policies": {
   "additionalProperties": {
    "$ref": "#/$defs/Entry"
   },
   "title": "Policies",
   "type": "object"
  }
 },
 "required": [
  "channel",
  "policies"
 ],
 "title": "PolicySet",
 "type": "object"
}
