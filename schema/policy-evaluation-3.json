{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/gotalab/s1flow/blob/main/schema/policy-evaluation-3.json",
 "$defs": {
  "Calls": {
   "additionalProperties": false,
   "description": "What the calls took rather than what they answered: how long an app waits and what the model charges\n(API cost). Read from the call records alone (metrics.calls).",
   "properties": {
    "latency": {
     "anyOf": [
      {
       "$ref": "#/$defs/Latency"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "case_latency_p90_ms": {
     "anyOf": [
      {
       "$ref": "#/$defs/Estimate"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "throughput": {
     "anyOf": [
      {
       "$ref": "#/$defs/Throughput"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "cost_per_10k_usd": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Cost Per 10K Usd"
    },
    "cost_total_usd": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Cost Total Usd"
    },
    "cost_source": {
     "anyOf": [
      {
       "enum": [
        "billed",
        "list",
        "mixed"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Cost Source"
    },
    "cost_unknown": {
     "default": 0,
     "title": "Cost Unknown",
     "type": "integer"
    },
    "price": {
     "anyOf": [
      {
       "$ref": "#/$defs/Price"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    }
   },
   "title": "Calls",
   "type": "object"
  },
  "Candidate": {
   "additionalProperties": false,
   "properties": {
    "model": {
     "title": "Model",
     "type": "string"
    },
    "variant": {
     "default": "base",
     "title": "Variant",
     "type": "string"
    }
   },
   "required": [
    "model"
   ],
   "title": "Candidate",
   "type": "object"
  },
  "DecisionRule": {
   "additionalProperties": false,
   "description": "Binary threshold and optional lower bound on the chosen value's probability.",
   "properties": {
    "threshold": {
     "anyOf": [
      {
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Threshold"
    },
    "min_probability": {
     "anyOf": [
      {
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Min Probability"
    }
   },
   "title": "DecisionRule",
   "type": "object"
  },
  "ErrorLossThreshold": {
   "additionalProperties": false,
   "description": "A binary task's P(positive) cut, chosen as ExpectedLoss chooses it on the task's error losses (else 1 and 1).",
   "properties": {
    "accuracy": {
     "title": "Accuracy",
     "type": "number"
    },
    "misses": {
     "title": "Misses",
     "type": "integer"
    },
    "false_alarms": {
     "title": "False Alarms",
     "type": "integer"
    },
    "median": {
     "title": "Median",
     "type": "number"
    },
    "chosen": {
     "title": "Chosen",
     "type": "number"
    }
   },
   "required": [
    "accuracy",
    "misses",
    "false_alarms",
    "median",
    "chosen"
   ],
   "title": "ErrorLossThreshold",
   "type": "object"
  },
  "Estimate": {
   "additionalProperties": false,
   "properties": {
    "value": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "title": "Value"
    },
    "interval": {
     "anyOf": [
      {
       "maxItems": 2,
       "minItems": 2,
       "prefixItems": [
        {
         "type": "number"
        },
        {
         "type": "number"
        }
       ],
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Interval"
    }
   },
   "required": [
    "value"
   ],
   "title": "Estimate",
   "type": "object"
  },
  "Evaluation": {
   "additionalProperties": false,
   "properties": {
    "candidate": {
     "$ref": "#/$defs/Candidate"
    },
    "answered_by": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Answered By"
    },
    "answered_by_all": {
     "items": {
      "type": "string"
     },
     "title": "Answered By All",
     "type": "array"
    },
    "answered_ids": {
     "items": {
      "type": "string"
     },
     "title": "Answered Ids",
     "type": "array"
    },
    "n": {
     "title": "N",
     "type": "integer"
    },
    "probabilities": {
     "title": "Probabilities",
     "type": "boolean"
    },
    "failures": {
     "$ref": "#/$defs/Failures"
    },
    "split": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Split"
    },
    "split_method": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Split Method"
    },
    "accuracy": {
     "anyOf": [
      {
       "$ref": "#/$defs/Estimate"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "measures": {
     "additionalProperties": {
      "$ref": "#/$defs/Estimate"
     },
     "default": {},
     "title": "Measures",
     "type": "object"
    },
    "auroc": {
     "anyOf": [
      {
       "$ref": "#/$defs/Estimate"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "brier": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Brier"
    },
    "ece": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Ece"
    },
    "selective": {
     "default": [],
     "items": {
      "$ref": "#/$defs/Selective"
     },
     "title": "Selective",
     "type": "array"
    },
    "error_loss_threshold": {
     "anyOf": [
      {
       "$ref": "#/$defs/ErrorLossThreshold"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "floors": {
     "default": [],
     "items": {
      "$ref": "#/$defs/Floor"
     },
     "title": "Floors",
     "type": "array"
    },
    "sweep": {
     "anyOf": [
      {
       "items": {
        "$ref": "#/$defs/SweepRow"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Sweep"
    },
    "objective": {
     "anyOf": [
      {
       "$ref": "#/$defs/ObjectiveScore"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "tiebreak": {
     "default": [],
     "items": {
      "$ref": "#/$defs/ObjectiveScore"
     },
     "title": "Tiebreak",
     "type": "array"
    },
    "test": {
     "anyOf": [
      {
       "$ref": "#/$defs/TestResult"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "high_confidence_errors": {
     "default": [],
     "items": {
      "$ref": "#/$defs/HighConfidenceError"
     },
     "title": "High Confidence Errors",
     "type": "array"
    },
    "calls": {
     "$ref": "#/$defs/Calls",
     "default": {
      "latency": null,
      "case_latency_p90_ms": null,
      "throughput": null,
      "cost_per_10k_usd": null,
      "cost_total_usd": null,
      "cost_source": null,
      "cost_unknown": 0,
      "price": null
     }
    }
   },
   "required": [
    "candidate",
    "answered_by",
    "answered_by_all",
    "answered_ids",
    "n",
    "probabilities",
    "failures"
   ],
   "title": "Evaluation",
   "type": "object"
  },
  "Evidence": {
   "additionalProperties": false,
   "properties": {
    "data_sha256": {
     "title": "Data Sha256",
     "type": "string"
    },
    "execution_digest": {
     "title": "Execution Digest",
     "type": "string"
    },
    "input_adapter_digest": {
     "title": "Input Adapter Digest",
     "type": "string"
    },
    "evaluation_contract_digest": {
     "title": "Evaluation Contract Digest",
     "type": "string"
    },
    "git_sha": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Git Sha"
    },
    "evaluation": {
     "$ref": "#/$defs/Evaluation"
    },
    "test": {
     "anyOf": [
      {
       "enum": [
        "kept",
        "below",
        "inconclusive"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Test"
    },
    "compared": {
     "items": {
      "type": "string"
     },
     "title": "Compared",
     "type": "array"
    }
   },
   "required": [
    "data_sha256",
    "execution_digest",
    "input_adapter_digest",
    "evaluation_contract_digest",
    "evaluation",
    "test",
    "compared"
   ],
   "title": "Evidence",
   "type": "object"
  },
  "Failures": {
   "additionalProperties": false,
   "description": "`calls` to `unlabeled` count call records; the `*_cases` and `never_asked` count labelled cases.\nA case never asked or with every call failed has no answer the model gave: a candidate missing one is\nnot compared with the others (`missing`). A refused case is the model's limit, left out of its denominator.",
   "properties": {
    "calls": {
     "title": "Calls",
     "type": "integer"
    },
    "failed": {
     "title": "Failed",
     "type": "integer"
    },
    "unsupported": {
     "title": "Unsupported",
     "type": "integer"
    },
    "data_errors": {
     "title": "Data Errors",
     "type": "integer"
    },
    "unlabeled": {
     "title": "Unlabeled",
     "type": "integer"
    },
    "never_asked": {
     "title": "Never Asked",
     "type": "integer"
    },
    "failed_cases": {
     "title": "Failed Cases",
     "type": "integer"
    },
    "refused_cases": {
     "title": "Refused Cases",
     "type": "integer"
    }
   },
   "required": [
    "calls",
    "failed",
    "unsupported",
    "data_errors",
    "unlabeled",
    "never_asked",
    "failed_cases",
    "refused_cases"
   ],
   "title": "Failures",
   "type": "object"
  },
  "Floor": {
   "additionalProperties": false,
   "description": "One of the task's floors (Constraints.min_precision, min_recall) at the threshold the primary objective sets.",
   "properties": {
    "what": {
     "title": "What",
     "type": "string"
    },
    "bound": {
     "title": "Bound",
     "type": "number"
    },
    "rate": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "title": "Rate"
    },
    "test": {
     "anyOf": [
      {
       "maxItems": 2,
       "minItems": 2,
       "prefixItems": [
        {
         "type": "integer"
        },
        {
         "type": "integer"
        }
       ],
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Test"
    }
   },
   "required": [
    "what",
    "bound",
    "rate"
   ],
   "title": "Floor",
   "type": "object"
  },
  "HighConfidenceError": {
   "additionalProperties": false,
   "properties": {
    "id": {
     "title": "Id",
     "type": "string"
    },
    "label": {
     "anyOf": [
      {
       "type": "boolean"
      },
      {
       "type": "string"
      }
     ],
     "title": "Label"
    },
    "predicted": {
     "anyOf": [
      {
       "type": "boolean"
      },
      {
       "type": "string"
      }
     ],
     "title": "Predicted"
    },
    "probability": {
     "title": "Probability",
     "type": "number"
    }
   },
   "required": [
    "id",
    "label",
    "predicted",
    "probability"
   ],
   "title": "HighConfidenceError",
   "type": "object"
  },
  "JsonValue": {},
  "Latency": {
   "additionalProperties": false,
   "description": "Per answered call: the answering attempt alone (retries left out).",
   "properties": {
    "n": {
     "title": "N",
     "type": "integer"
    },
    "p50_ms": {
     "title": "P50 Ms",
     "type": "number"
    },
    "p90_ms": {
     "title": "P90 Ms",
     "type": "number"
    },
    "p95_ms": {
     "title": "P95 Ms",
     "type": "number"
    },
    "p99_ms": {
     "title": "P99 Ms",
     "type": "number"
    },
    "max_ms": {
     "title": "Max Ms",
     "type": "number"
    },
    "spread": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "title": "Spread"
    },
    "retried": {
     "title": "Retried",
     "type": "integer"
    },
    "concurrency": {
     "items": {
      "type": "integer"
     },
     "title": "Concurrency",
     "type": "array"
    },
    "concurrency_unknown": {
     "title": "Concurrency Unknown",
     "type": "integer"
    }
   },
   "required": [
    "n",
    "p50_ms",
    "p90_ms",
    "p95_ms",
    "p99_ms",
    "max_ms",
    "spread",
    "retried",
    "concurrency",
    "concurrency_unknown"
   ],
   "title": "Latency",
   "type": "object"
  },
  "Objective": {
   "additionalProperties": false,
   "description": "One objective. Everything that changes its value is in `params`; `sets` is the Rule field it\nchooses (None: it reads the plain answer).",
   "properties": {
    "name": {
     "title": "Name",
     "type": "string"
    },
    "params": {
     "additionalProperties": {
      "$ref": "#/$defs/JsonValue"
     },
     "default": {},
     "title": "Params",
     "type": "object"
    },
    "direction": {
     "enum": [
      "max",
      "min"
     ],
     "title": "Direction",
     "type": "string"
    },
    "sets": {
     "anyOf": [
      {
       "enum": [
        "min_probability",
        "threshold"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Sets"
    },
    "unit": {
     "enum": [
      "share",
      "number"
     ],
     "title": "Unit",
     "type": "string"
    },
    "label": {
     "title": "Label",
     "type": "string"
    },
    "code_sha256": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Code Sha256"
    }
   },
   "required": [
    "name",
    "direction",
    "sets",
    "unit",
    "label"
   ],
   "title": "Objective",
   "type": "object"
  },
  "ObjectiveScore": {
   "additionalProperties": false,
   "description": "One of the task's objectives.",
   "properties": {
    "objective": {
     "$ref": "#/$defs/Objective"
    },
    "value": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "title": "Value"
    },
    "interval": {
     "anyOf": [
      {
       "maxItems": 2,
       "minItems": 2,
       "prefixItems": [
        {
         "type": "number"
        },
        {
         "type": "number"
        }
       ],
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Interval"
    },
    "rule": {
     "anyOf": [
      {
       "$ref": "#/$defs/DecisionRule"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "constraint": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Constraint"
    }
   },
   "required": [
    "objective",
    "value"
   ],
   "title": "ObjectiveScore",
   "type": "object"
  },
  "Price": {
   "additionalProperties": false,
   "description": "A model's list price, declared in s1flow.toml (`price.input_per_mtok = ...`) for a model that bills nothing back.\n\nWhat it costs is an estimate from the tokens the model reports (client/cost.py): a model can charge what\ntokens do not show (cached input, unseen reasoning, a minimum), so a model that returns what it billed\n(AI Gateway, OpenRouter) is never priced from here. A price these four parts cannot write is left out.",
   "properties": {
    "input_per_mtok": {
     "default": 0.0,
     "minimum": 0,
     "title": "Input Per Mtok",
     "type": "number"
    },
    "output_per_mtok": {
     "default": 0.0,
     "minimum": 0,
     "title": "Output Per Mtok",
     "type": "number"
    },
    "per_request": {
     "default": 0.0,
     "minimum": 0,
     "title": "Per Request",
     "type": "number"
    },
    "per_image": {
     "default": 0.0,
     "minimum": 0,
     "title": "Per Image",
     "type": "number"
    },
    "as_of": {
     "title": "As Of",
     "type": "string"
    },
    "source": {
     "title": "Source",
     "type": "string"
    }
   },
   "required": [
    "as_of",
    "source"
   ],
   "title": "Price",
   "type": "object"
  },
  "Selection": {
   "additionalProperties": false,
   "description": "Who picked the candidate and why. s1flow records the pick; it does not recommend one.",
   "properties": {
    "by": {
     "title": "By",
     "type": "string"
    },
    "reason": {
     "title": "Reason",
     "type": "string"
    },
    "tied": {
     "items": {
      "type": "string"
     },
     "title": "Tied",
     "type": "array"
    },
    "forced": {
     "default": false,
     "title": "Forced",
     "type": "boolean"
    }
   },
   "required": [
    "by",
    "reason",
    "tied"
   ],
   "title": "Selection",
   "type": "object"
  },
  "Selective": {
   "additionalProperties": false,
   "description": "Answer sure only where the probability reaches a cut, keeping `target_accuracy` on the sure answers.",
   "properties": {
    "target_accuracy": {
     "title": "Target Accuracy",
     "type": "number"
    },
    "coverage": {
     "$ref": "#/$defs/Estimate"
    },
    "accuracy": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "title": "Accuracy"
    },
    "n": {
     "title": "N",
     "type": "integer"
    },
    "errors": {
     "title": "Errors",
     "type": "integer"
    },
    "lower": {
     "title": "Lower",
     "type": "number"
    },
    "labels_needed": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "title": "Labels Needed"
    },
    "min_probability": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "title": "Min Probability"
    }
   },
   "required": [
    "target_accuracy",
    "coverage",
    "accuracy",
    "n",
    "errors",
    "lower",
    "labels_needed",
    "min_probability"
   ],
   "title": "Selective",
   "type": "object"
  },
  "SweepRow": {
   "additionalProperties": false,
   "description": "Per run: a positive below the threshold is a miss, a negative at or above it a false alarm.",
   "properties": {
    "threshold": {
     "title": "Threshold",
     "type": "number"
    },
    "misses": {
     "title": "Misses",
     "type": "integer"
    },
    "positives": {
     "title": "Positives",
     "type": "integer"
    },
    "false_alarms": {
     "title": "False Alarms",
     "type": "integer"
    },
    "negatives": {
     "title": "Negatives",
     "type": "integer"
    }
   },
   "required": [
    "threshold",
    "misses",
    "positives",
    "false_alarms",
    "negatives"
   ],
   "title": "SweepRow",
   "type": "object"
  },
  "TestResult": {
   "additionalProperties": false,
   "properties": {
    "n": {
     "title": "N",
     "type": "integer"
    },
    "accuracy": {
     "title": "Accuracy",
     "type": "number"
    },
    "coverage": {
     "title": "Coverage",
     "type": "number"
    },
    "sure_accuracy": {
     "anyOf": [
