{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/gotalab/s1flow/blob/main/schema/response-1.json",
 "$defs": {
  "BooleanAnswer": {
   "additionalProperties": false,
   "properties": {
    "type": {
     "const": "boolean",
     "default": "boolean",
     "title": "Type",
     "type": "string"
    },
    "probability": {
     "title": "Probability",
     "type": "number"
    }
   },
   "required": [
    "probability"
   ],
   "title": "BooleanAnswer",
   "type": "object"
  },
  "BoxAnswer": {
   "additionalProperties": false,
   "properties": {
    "type": {
     "const": "box",
     "default": "box",
     "title": "Type",
     "type": "string"
    },
    "box": {
     "anyOf": [
      {
       "$ref": "#/$defs/BoxEdges"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "found": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Found"
    },
    "confidence": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Confidence"
    },
    "agreement": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Agreement"
    }
   },
   "title": "BoxAnswer",
   "type": "object"
  },
  "BoxEdges": {
   "description": "Edges as fractions of the image's height (top, bottom) and width (left, right), from the top-left.",
   "properties": {
    "top": {
     "maximum": 1,
     "minimum": 0,
     "title": "Top",
     "type": "number"
    },
    "bottom": {
     "maximum": 1,
     "minimum": 0,
     "title": "Bottom",
     "type": "number"
    },
    "left": {
     "maximum": 1,
     "minimum": 0,
     "title": "Left",
     "type": "number"
    },
    "right": {
     "maximum": 1,
     "minimum": 0,
     "title": "Right",
     "type": "number"
    }
   },
   "required": [
    "top",
    "bottom",
    "left",
    "right"
   ],
   "title": "BoxEdges",
   "type": "object"
  },
  "ChoiceAnswer": {
   "additionalProperties": false,
   "properties": {
    "type": {
     "const": "choice",
     "default": "choice",
     "title": "Type",
     "type": "string"
    },
    "choice": {
     "title": "Choice",
     "type": "string"
    },
    "probabilities": {
     "anyOf": [
      {
       "additionalProperties": {
        "type": "number"
       },
       "type": "object"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Probabilities"
    },
    "confidence": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Confidence"
    }
   },
   "required": [
    "choice"
   ],
   "title": "ChoiceAnswer",
   "type": "object"
  },
  "DateAnswer": {
   "additionalProperties": false,
   "properties": {
    "p_null": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "P Null"
    },
    "confidence": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Confidence"
    },
    "span": {
     "anyOf": [
      {
       "maxItems": 2,
       "minItems": 2,
       "prefixItems": [
        {
         "type": "integer"
        },
        {
         "type": "integer"
        }
       ],
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Span"
    },
    "type": {
     "const": "date",
     "default": "date",
     "title": "Type",
     "type": "string"
    },
    "value": {
     "anyOf": [
      {
       "format": "date",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Value"
    },
    "guess": {
     "anyOf": [
      {
       "format": "date",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Guess"
    }
   },
   "title": "DateAnswer",
   "type": "object"
  },
  "EstimateAnswer": {
   "additionalProperties": false,
   "properties": {
    "type": {
     "const": "estimate",
     "default": "estimate",
     "title": "Type",
     "type": "string"
    },
    "value": {
     "title": "Value",
     "type": "number"
    },
    "p10": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "P10"
    },
    "p90": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "P90"
    }
   },
   "required": [
    "value"
   ],
   "title": "EstimateAnswer",
   "type": "object"
  },
  "MultiChoiceAnswer": {
   "additionalProperties": false,
   "properties": {
    "type": {
     "const": "multichoice",
     "default": "multichoice",
     "title": "Type",
     "type": "string"
    },
    "choices": {
     "items": {
      "type": "string"
     },
     "title": "Choices",
     "type": "array"
    },
    "probabilities": {
     "anyOf": [
      {
       "additionalProperties": {
        "type": "number"
       },
       "type": "object"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Probabilities"
    }
   },
   "required": [
    "choices"
   ],
   "title": "MultiChoiceAnswer",
   "type": "object"
  },
  "NumberAnswer": {
   "additionalProperties": false,
   "properties": {
    "p_null": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "P Null"
    },
    "confidence": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Confidence"
    },
    "span": {
     "anyOf": [
      {
       "maxItems": 2,
       "minItems": 2,
       "prefixItems": [
        {
         "type": "integer"
        },
        {
         "type": "integer"
        }
       ],
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Span"
    },
    "type": {
     "const": "number",
     "default": "number",
     "title": "Type",
     "type": "string"
    },
    "value": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Value"
    },
    "guess": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Guess"
    }
   },
   "title": "NumberAnswer",
   "type": "object"
  },
  "Refusal": {
   "additionalProperties": false,
   "description": "The model declined to answer this question (its limit, not a failed call).",
   "properties": {
    "type": {
     "const": "refusal",
     "default": "refusal",
     "title": "Type",
     "type": "string"
    },
    "reason": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Reason"
    }
   },
   "title": "Refusal",
   "type": "object"
  },
  "ScoreAnswer": {
   "additionalProperties": false,
   "properties": {
    "type": {
     "const": "score",
     "default": "score",
     "title": "Type",
     "type": "string"
    },
    "score": {
     "title": "Score",
     "type": "number"
    },
    "probabilities": {
     "anyOf": [
      {
       "additionalProperties": {
        "type": "number"
       },
       "type": "object"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Probabilities"
    },
    "confidence": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Confidence"
    }
   },
   "required": [
    "score"
   ],
   "title": "ScoreAnswer",
   "type": "object"
  },
  "TextAnswer": {
   "additionalProperties": false,
   "properties": {
    "p_null": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "P Null"
    },
    "confidence": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Confidence"
    },
    "span": {
     "anyOf": [
      {
       "maxItems": 2,
       "minItems": 2,
       "prefixItems": [
        {
         "type": "integer"
        },
        {
         "type": "integer"
        }
       ],
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Span"
    },
    "type": {
     "const": "text",
     "default": "text",
     "title": "Type",
     "type": "string"
    },
    "value": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Value"
    },
    "guess": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Guess"
    }
   },
   "title": "TextAnswer",
   "type": "object"
  },
  "Usage": {
   "additionalProperties": false,
   "properties": {
    "input_tokens": {
     "default": 0,
     "title": "Input Tokens",
     "type": "integer"
    },
    "output_tokens": {
     "default": 0,
     "title": "Output Tokens",
     "type": "integer"
    },
    "cost_usd": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Cost Usd"
    },
    "cost_source": {
     "anyOf": [
      {
       "enum": [
        "billed",
        "list"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Cost Source"
    },
    "raw": {
     "anyOf": [
      {
       "additionalProperties": true,
       "type": "object"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Raw"
    }
   },
   "title": "Usage",
   "type": "object"
  }
 },
 "additionalProperties": false,
 "description": "One call's answers, keyed by question name.",
 "properties": {
  "answers": {
   "additionalProperties": {
    "discriminator": {
     "mapping": {
      "boolean": "#/$defs/BooleanAnswer",
      "box": "#/$defs/BoxAnswer",
      "choice": "#/$defs/ChoiceAnswer",
      "date": "#/$defs/DateAnswer",
      "estimate": "#/$defs/EstimateAnswer",
      "multichoice": "#/$defs/MultiChoiceAnswer",
      "number": "#/$defs/NumberAnswer",
      "refusal": "#/$defs/Refusal",
      "score": "#/$defs/ScoreAnswer",
      "text": "#/$defs/TextAnswer"
     },
     "propertyName": "type"
    },
    "oneOf": [
     {
      "$ref": "#/$defs/BooleanAnswer"
     },
     {
      "$ref": "#/$defs/ChoiceAnswer"
     },
     {
      "$ref": "#/$defs/ScoreAnswer"
     },
     {
      "$ref": "#/$defs/BoxAnswer"
     },
     {
      "$ref": "#/$defs/TextAnswer"
     },
     {
      "$ref": "#/$defs/NumberAnswer"
     },
     {
      "$ref": "#/$defs/DateAnswer"
     },
     {
      "$ref": "#/$defs/EstimateAnswer"
     },
     {
      "$ref": "#/$defs/MultiChoiceAnswer"
     },
     {
      "$ref": "#/$defs/Refusal"
     }
    ]
   },
   "title": "Answers",
   "type": "object"
  },
  "answered_by": {
   "title": "Answered By",
   "type": "string"
  },
  "usage": {
   "$ref": "#/$defs/Usage"
  },
  "latency_ms": {
   "default": 0.0,
   "title": "Latency Ms",
   "type": "number"
  },
  "retries": {
   "default": 0,
   "title": "Retries",
   "type": "integer"
  },
  "provider_metadata": {
   "additionalProperties": true,
   "title": "Provider Metadata",
   "type": "object"
  }
 },
 "required": [
  "answers",
  "answered_by"
 ],
 "title": "Response",
 "type": "object"
}
